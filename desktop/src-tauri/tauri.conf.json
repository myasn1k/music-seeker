{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "MusicSeeker",
  "version": "1.0.0",
  "identifier": "org.orochi.musicseeker",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MusicSeeker",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 600,
        "url": "index.html",
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src * 'unsafe-inline' 'unsafe-eval' blob: data: media:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
